    <title>Fuego Noble – Salsas Gourmet</title>

    <style>
        Body {
            Font-family: ‘Times New Roman’, Times, serif; 
            Margin: 0;
            Background-color: #1ª1a1a; 
            Color: #f0f0f0; 
            Line-height: 1.6;
            Overflow-x: hidden; 
        }

        H2, h3 {
            Color: #e0b06b; 
            Text-align: center;
            Margin-bottom: 10px;
            Text-transform: uppercase;
            Letter-spacing: 2px;
        }
        
        A {
            Text-decoration: none;
            Color: #e0b06b;
        }

        A:hover {
            Text-decoration: underline;
            Color: #ffcc99;
        }

        .header {
            Text-align: center;
            Background-color: #000; 
            Padding: 15px 10px;
            Border-bottom: 3px solid #e0b06b; 
            Position: relative;
        }
        
        .header .logo-container img {
            Max-width: 150px;
            Height: auto;
        }

        .container {
            Padding: 20px;
            Max-width: 1000px; 
            Margin: auto;
        }

        .master-banner {
            Background: url(https://drive.google.com/thumbnail?id=1W68qAP6aIGpmJKCLBU_p8JYVVwA9dA-p) no-repeat center center;
            Background-size: cover;
            Min-height: 400px;
            Display: flex;
            Flex-direction: column;
            Justify-content: center;
            Align-items: center;
            Text-align: center;
            Padding: 40px 20px;
            Position: relative;
        }
        
        .master-banner::before {
            Content: ‘’;
            Position: absolute;
            Top: 0;
            Left: 0;
            Right: 0;
            Bottom: 0;
            Background-color: rgba(0, 0, 0, 0.65);
        }
        
        .master-banner h1, .master-banner p {
            Position: relative;
            z-index: 1;
            color: white;
        }
        
        .master-banner .cta-button {
            Position: relative;
            z-index: 1;
            padding: 12px 30px;
            background-color: #e0b06b;
            color: #1ª1a1a;
            border: none;
            border-radius: 5px;
            font-size: 1.1rem;
            font-weight: bold;
            margin-top: 20px;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        
        .master-banner .cta-button:hover {
            Background-color: #ffcc99;
        }

        .video-container {
            Position: relative;
            Padding-bottom: 56.25%; 
            Height: 0;
            Overflow: hidden;
            Margin: 20px auto 40px auto; 
            Max-width: 800px; 
            Box-shadow: 0 5px 15px rgba(0, 0, 0, 0.5);
        }

        .responsive-video {
            Position: absolute;
            Top: 0;
            Left: 0;
            Width: 100%;
            Height: 100%;
            Border: none;
        }

        .intro-text { 
            Text-align: center; 
            Margin-bottom: 30px; 
            Color: #ccc; 
        }

        .product-categories { 
            Margin-bottom: 40px; 
        }

        .category-header { 
            Background-color: #333; 
            Color: #e0b06b; 
            Text-align: center; 
            Padding: 15px; 
            Margin-bottom: 15px; 
            Font-size: 1.4rem; 
            Text-transform: uppercase; 
            Letter-spacing: 3px; 
        }
        
        .product-grid {
            Display: flex;
            Justify-content: space-around;
            Flex-wrap: wrap;
            Gap: 20px;
        }

        .product-card {
            Background-color: #2ª2a2a;
            Border: 1px solid #444;
            Border-radius: 5px;
            Text-align: center;
            Padding: 15px;
            Width: 280px; 
            Transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .product-card:hover {
            Transform: translateY(-5px);
            Box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
        }

        .product-card img {
            Width: 80%;
            Height: auto;
            Border-radius: 5px;
        }

        .footer {
            Text-align: center;
            Padding: 20px;
            Background-color: #000;
            Color: #888;
            Border-top: 3px solid #e0b06b;
            Font-size: 0.9rem;
